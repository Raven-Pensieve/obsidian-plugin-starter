{
	"name": "obsidian-plugin-starter",
	"version": "1.0.0",
	"description": "This is a sample plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"scripts": {
		"dev": "node --env-file-if-exists=.env scripts/deploy.mjs link && node scripts/esbuild.config.mjs dev",
		"build": "tsc -noEmit -skipLibCheck && node scripts/esbuild.config.mjs prod && node --env-file-if-exists=.env scripts/deploy.mjs copy",
		"lint": "eslint src/ styles/",
		"i18n:typesafe": "typesafe-i18n",
		"i18n:sync": "node scripts/sync-i18n.mjs",
		"test": "jest",
		"test:watch": "jest --watch"
	},
	"keywords": [
		"Obsidian Plugin"
	],
	"author": "RavenHogWarts",
	"license": "MIT",
	"engines": {
		"node": ">=22.x"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"esbuild": "0.28.1",
		"eslint": "^10.7.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.7.0",
		"jest": "^30.4.2",
		"lucide-react": "^1.25.0",
		"obsidian": "^1.13.1",
		"postcss": "^8.5.19",
		"postcss-nesting": "^14.0.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"release-please": "^17.11.1",
		"ts-jest": "^29.4.11",
		"tslib": "2.8.1",
		"typesafe-i18n": "^5.27.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.64.0"
	}
}
